# Copy to .env.local (never commit the real file)

NEXT_PUBLIC_CURRENCY_SYMBOL='₦'
ADMIN_EMAIL="you@example.com"            # comma-separate for several admins

DATABASE_URL="postgresql://..."           # Neon pooled connection
DIRECT_URL="postgresql://..."             # Neon direct connection (Prisma CLI)

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

IMAGEKIT_PUBLIC_KEY="..."
IMAGEKIT_PRIVATE_KEY="..."
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/..."

# Paystack — Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_...           # use sk_live_... when you go live
NEXT_PUBLIC_SITE_URL=https://layahs-scent-perfume.vercel.app
