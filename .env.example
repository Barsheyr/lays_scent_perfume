# Copy to .env.local (never commit the real file)

NEXT_PUBLIC_CURRENCY_SYMBOL='₦'
ADMIN_EMAIL="you@example.com"            # comma-separate for several admins

DATABASE_URL="postgresql://..."           # Neon pooled connection
DIRECT_URL="postgresql://..."             # Neon direct connection (Prisma CLI)

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

IMAGEKIT_PUBLIC_KEY="..."
IMAGEKIT_PRIVATE_KEY="..."
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/..."

# Paystack — Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_...           # use sk_live_... when you go live
# Optional: your public site address (no NEXT_PUBLIC_ prefix needed).
# If left out, the site uses its own address automatically.
SITE_URL=

# New-order alerts (optional — leave blank to turn off)
# Telegram: create a bot with @BotFather, message it once, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=                        # comma-separate to alert several people
# Email via resend.com (free tier)
RESEND_API_KEY=
NOTIFY_EMAILS=                            # e.g. you@gmail.com,seller@gmail.com
NOTIFY_FROM="Layah's Scent <onboarding@resend.dev>"

# Automatic WhatsApp updates to customers (optional — WhatsApp Business Cloud API)
# Without these, the admin gets a one-tap "Send WhatsApp" button instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
